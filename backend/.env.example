NODE_ENV=development
PORT=3000

# PostgreSQL (matches root docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/client_project_dashboard

# JWT (use strong random secrets in production)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (required for frontend — local Vite dev or Vercel production origin)
CORS_ORIGIN=http://localhost:5173

# Background jobs (set false in test processes; invoke the job function directly)
ENABLE_CRON_JOBS=true
OVERDUE_CRON_SCHEDULE=0 * * * *
