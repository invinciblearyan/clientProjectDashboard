# Backend REST API base URL.
# Local dev with Vite proxy (vite.config.ts): leave empty or omit this file's values
# so requests use same-origin /api paths.
# VITE_API_URL=

# Production (Vercel): set to your Railway backend URL, e.g. https://your-app.up.railway.app
VITE_API_URL=http://localhost:3000

# Socket.IO server URL (used in later phases).
# Local dev with Vite proxy: leave empty for same-origin /socket.io
VITE_WS_URL=http://localhost:3000
